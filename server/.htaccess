# Vraj Kheti Hisab — hardening for the web folder that holds backup_receiver.php
# Install as: /home/<cpanel-user>/public_html/vraj/.htaccess
#
# Only backup_receiver.php is reachable. Everything else in this folder
# (README, example config, tests, .user.ini, logs) is denied.
# The backups themselves live OUTSIDE public_html (see store_dir.htaccess).

Options -Indexes
ServerSignature Off

# Deny everything by default ...
<IfModule mod_authz_core.c>
    Require all denied
    # ... except the receiver itself.
    <Files "backup_receiver.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "backup_receiver.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# Optional: point the script at a config file in a non-default location.
# SetEnv VRAJ_CONFIG /home/REPLACE_CPANEL_USER/vraj_config.php

# Optional: Apache-level upload cap (~210 MB). Uncomment only if your host
# allows it in .htaccess (a "500 Internal Server Error" means it does not).
# LimitRequestBody 220200960
